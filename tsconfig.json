{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": [
    "node_modules",
    ".vercel",
    "dist",
    "app/layout.tsx",
    "app/page.tsx",
    "app/archive-admin",
    "app/archive-library",
    "app/data/traces-admin.ts",
    "app/trace-archive 2.tsx",
    "db/index.ts",
    "worker/index 2.ts",
    "examples",
    "vite.config.ts"
  ]
}
