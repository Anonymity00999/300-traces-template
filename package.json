{
  "name": "300-traces-replication",
  "version": "2026.9.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts --host 127.0.0.1",
    "build": "npm run build:vercel",
    "build:vercel": "vite build --config vite.static.config.ts",
    "start": "vite preview --config vite.static.config.ts --host 127.0.0.1",
    "test": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm run validate:content && npm test && npm run build && npm run verify:release"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@types/qrcode": "^1.5.6"
  }
}
